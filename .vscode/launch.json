{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Go: bailing serve (config.dev.yaml)",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/bailing",
			"args": ["serve", "-config", "${workspaceFolder}/config.dev.yaml"],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Go: bailing scan",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/bailing",
			"args": ["scan", "all", "-config", "${workspaceFolder}/config.dev.yaml"],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Browser: Chrome → Vite (localhost:5173)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}/web"
		}
	]
}

